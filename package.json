{
  "name": "edi-model-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./profiles": "./profiles.ts",
    "./runtime": "./runtime.ts"
  },
  "scripts": {
    "demo": "bun demo.ts",
    "demo:fast": "bun demo.ts --example fast",
    "demo:quality": "bun demo.ts --example quality",
    "demo:cli": "bun --env-file=.env.modal demo.ts --interactive",
    "evaluate": "python evaluation/run.py",
    "evaluation:report": "python evaluation/report.py",
    "lint": "oxlint *.ts && oxfmt --check *.ts *.json",
    "python:test": "python -m unittest discover -s training -p 'test_*.py' && python -m unittest discover -s benchmarking -p 'test_*.py' && python -m unittest discover -s evaluation -p 'test_*.py' && python -m unittest discover -s agents -p 'test_*.py' && python -m unittest discover -s routing -p 'test_*.py'",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "web": "bun --env-file=.env.modal next dev -H 127.0.0.1 -p 3001",
    "web:prod": "next build && bun --env-file=.env.modal next start -H 127.0.0.1 -p 3001",
    "web:backend": ".venv/bin/python routing/server.py --port 8765",
    "build:web": "next build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4",
    "@assistant-ui/ai-sdk": "^0.0.16",
    "@assistant-ui/react": "^0.15.32",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@json-render/core": "^0.21.3",
    "@json-render/react": "^0.21.3",
    "@json-render/react-three-fiber": "^0.21.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "ai": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "codemirror": "^6.0.2",
    "docx": "^9.15.1",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "5",
    "mermaid": "^12.2.0",
    "next": "16.2.9",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-data-grid": "7.0.0-beta.56",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tw-shimmer": "^0.4.14",
    "zod": "4.5.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.3.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
