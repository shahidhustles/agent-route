{
  "name": "edi-model-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./profiles": "./profiles.ts",
    "./runtime": "./runtime.ts"
  },
  "scripts": {
    "demo": "bun demo.ts",
    "demo:fast": "bun demo.ts --example fast",
    "demo:quality": "bun demo.ts --example quality",
    "demo:interactive": "bun --env-file=.env.modal next dev",
    "demo:cli": "bun --env-file=.env.modal demo.ts --interactive",
    "build:web": "next build",
    "evaluate": "python evaluation/run.py",
    "evaluation:report": "python evaluation/report.py",
    "lint": "oxlint *.ts && oxfmt --check *.ts *.json",
    "python:test": "python -m unittest discover -s training -p 'test_*.py' && python -m unittest discover -s benchmarking -p 'test_*.py' && python -m unittest discover -s evaluation -p 'test_*.py'",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/react": "^4",
    "@assistant-ui/ai-sdk": "^0.0.7",
    "@assistant-ui/react": "^0.15.21",
    "@assistant-ui/react-markdown": "^0.14.16",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "ai": "^7",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "5.9.3"
  }
}
