{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "cc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code (through the host proxy)",
      "options": {
        "baseURL": "{env:CC_BASE_URL}",
        "apiKey": "{env:CC_RUN_TOKEN}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {"name": "DeepSeek V4.1 Flash", "limit": {"context": 128000, "output": 12000}},
        "z-ai/glm-5.3-flash": {"name": "GLM 5.3 Flash", "limit": {"context": 128000, "output": 12000}},
        "xiaomi/mimo-v2.6-flash": {"name": "MiMo V2.6 Flash", "limit": {"context": 128000, "output": 12000}},
        "nvidia/nemotron-3.5-super-vl": {"name": "Nemotron 3.5 Super VL", "limit": {"context": 128000, "output": 12000}}
      }
    }
  }
}
