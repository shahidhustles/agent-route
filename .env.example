# Clerk (Google sign-in). Create an app at https://dashboard.clerk.com, enable Google, then copy both keys
# from "API keys". Without them the app shows a setup screen and the API routes answer 503.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signed-out users see the sign-in screen at "/", and Google returns to /sso-callback.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (saved chats, runs and artifacts). Project Settings > API. Without them chats stay in memory.
# The browser and the server both use the public key plus the Clerk session token; row-level security does the rest.
# There is no service-role key anywhere in this app, and none should be added.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
